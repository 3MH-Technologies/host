# 3MH Host Production Environment Configuration Template
# Copy this file to .env on your production server and update values

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate_a_random_32_byte_hex_string_here

# Application Database
DATABASE_URL="file:./db/custom.db"

# Server Ports
PORT=3000
PROCESS_MANAGER_PORT=3001
TERMINAL_SERVICE_PORT=3002

# Zero-Trust Sandbox Config
SANDBOX_RUNTIME=runsc
SANDBOX_ROOT_FS_READONLY=true
MAX_CONTAINER_MEMORY=512M
MAX_CONTAINER_CPUS=2.0
MAX_CONTAINER_PIDS=64

# Security Alert Email / Webhook (Optional)
ALERT_WEBHOOK_URL=
